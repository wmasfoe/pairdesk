{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PairDesk",
  "version": "0.1.16",
  "identifier": "com.pairdesk.app",
  "build": {
    "frontendDist": "../../app/dist"
  },
  "app": {
    "windows": [
      {
        "title": "PairDesk 远程协助",
        "width": 980,
        "height": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
